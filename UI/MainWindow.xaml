<Window x:Class="UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        >

    <Window.Resources>
        <!-- Title Tiêu đề-->
        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
        </Style>

        <Style x:Key="comboBoxTime" TargetType="ComboBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="30,1"/>
            <Setter Property="Background" Value="Black"/>
            <Setter Property="BorderBrush" Value="Blue"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Nút chính -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TextBox thời gian -->
        <Style x:Key="TimeTextBox" TargetType="TextBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#020617"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>


    </Window.Resources>


    <Grid>

        <TextBlock Text="TimeCritical" 
                   Style="{StaticResource TitleText}"
                   HorizontalAlignment="Center"
                   Foreground="Red"
                   FontSize="50"
                   Margin="0,10"
                   />

        <Border CornerRadius="18"
                Background="#121637"
                Padding="20"
                Width="620"
                Height="260"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="16"
                                  ShadowDepth="0"
                                  Opacity="0.35"
                                  Color="Black"/>
            </Border.Effect>
            <Grid>

                <Grid.RowDefinitions>
                    <!-- title -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <!-- time -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <!-- lock -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <!-- button -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề -->
                <StackPanel Orientation="Vertical" Grid.Row="0">
                    <TextBlock Text="Timer to shutdown Desktop" Foreground="Red" 
                               Style="{StaticResource TitleText}"
                               />
                    <TextBlock Text="Type hours &amp; minutes to set a timer"
                               Style="{StaticResource LabelText}"
                               Margin="40,0,0,0"
                               />
                </StackPanel>


                <!-- Hàng Start / End -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Start -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Start Time"
                                   Style="{StaticResource LabelText}"/>
                        <!-- Gợi ý định dạng: HH:mm -->
                        <TextBox x:Name="TxtStartTime"
                                 Style="{StaticResource TimeTextBox}"
                                 Text="22:30"/>
                    </StackPanel>

                    <!-- End -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="End Time"
                                   Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="TxtEndTime"
                                 Style="{StaticResource TimeTextBox}"
                                 Text="23:45"/>
                    </StackPanel>

                    <!-- End day: Today / Next day -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="End day"
                                   Style="{StaticResource LabelText}"/>
                        <ComboBox x:Name="CbxEndDay"
                                  Margin="6"
                                  Width="110"
                                  HorizontalAlignment="Left"
                                  >
                            <ComboBoxItem Content="Today" IsSelected="True"/>
                            <ComboBoxItem Content="Next day"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Checkbox Lock -->
                <CheckBox x:Name="ChkLock"
                          Grid.Row="4"
                          Margin="4,0,0,0"
                          Foreground="#E5E7EB"
                          FontSize="13"
                          Content="Lock Shutdown" />
                
                <CheckBox x:Name="ChkNow"
                          Grid.Row="5"
                          Margin="4,0,0,0"
                          Foreground="#E5E7EB"
                          FontSize="13"
                          Content="Start Now ?" />

                <!-- Nút đặt lịch -->
                <Button x:Name="btnSchedule"
                        Grid.Row="6"
                        Content="Set time"
                        Style="{StaticResource PrimaryButton}"
                        Click="BtnSchedule_Click"
                        />

            </Grid>
        </Border>
    </Grid>





</Window>
