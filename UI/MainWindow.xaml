<Window x:Class="UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        >

    <Window.Resources>
        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="comboBoxTime" TargetType="ComboBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="30,1"/>
            <Setter Property="Background" Value="Black"/>
            <Setter Property="BorderBrush" Value="Blue"/>
            <Setter Property="BorderThickness" Value="2"/>

        </Style>


    </Window.Resources>


    <Grid>
        <Border CornerRadius="12"
                Background="#111827"
                Padding="20"
                Width="620"
                Height="260"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
              >
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề -->
                <StackPanel Orientation="Horizontal" Grid.Row="0">
                    <TextBlock Text="Hẹn giờ tắt máy" Foreground="Red" 
                               Style="{StaticResource TitleText}"
                               />
                    <TextBlock Text="Chọn thời gian rồi bấm nút dưới"
                               Style="{StaticResource LabelText}"
                               Margin="40,0,0,0"
                               />
                </StackPanel>


                <Grid Grid.Row="2" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                </Grid>


                <!-- Chọn thời gian-->
                <StackPanel Orientation="Horizontal"  Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="Giờ" 
                               Style="{StaticResource LabelText}"
                               />
                    <ComboBox x:Name="cbxHour"
                              Style="{StaticResource comboBoxTime}"
                              >
                        <ComboBoxItem Content="00"/>
                        <ComboBoxItem Content="01"/>
                        <ComboBoxItem Content="02"/>
                        <ComboBoxItem Content="03"/>
                        <ComboBoxItem Content="04"/>
                        <ComboBoxItem Content="05"/>

                    </ComboBox>
                    <ComboBox x:Name="cbxMinute"
                              Style="{StaticResource comboBoxTime}"
                              >
                        <ComboBoxItem Content="05"/>
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="15"/>
                    </ComboBox>
                </StackPanel>

                <!-- 2 button-->
                
            </Grid>


        </Border>
    </Grid>





</Window>
